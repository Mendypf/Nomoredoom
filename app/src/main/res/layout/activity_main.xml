<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="36dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="30sp" />

        <!-- on or off -->
        <TextView
            android:id="@+id/status"
            style="@style/Text.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/status_detail"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:id="@+id/off_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/turn_on"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_app_button"
                android:stateListAnimator="@null"
                android:text="@string/turn_on"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/blocked_title" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/blocked_detail" />

            <Button
                android:id="@+id/open_app_info"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_app_button"
                android:stateListAnimator="@null"
                android:text="@string/open_app_info"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="16sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:background="@color/line" />

        <!-- today -->
        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/today_title" />

        <TextView
            android:id="@+id/today"
            style="@style/Text.Value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:background="@color/line" />

        <!-- the popups -->
        <Switch
            android:id="@+id/popups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="48dp"
            android:text="@string/popups_title"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/popups_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/sitting_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- this sitting -->
                <TextView
                    style="@style/Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/sitting_title" />

                <TextView
                    android:id="@+id/sitting"
                    style="@style/Text.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" />

                <ProgressBar
                    android:id="@+id/sitting_bar"
                    style="@android:style/Widget.Material.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:importantForAccessibility="no"
                    android:max="1000"
                    android:progressBackgroundTint="@color/line"
                    android:progressTint="@color/accent" />

                <TextView
                    android:id="@+id/sitting_note"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- the limit -->
            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:labelFor="@+id/limit"
                android:text="@string/limit_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/limit_less"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_app_button"
                    android:contentDescription="@string/limit_less"
                    android:stateListAnimator="@null"
                    android:text="@string/minus"
                    android:textColor="@color/ink"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/limit"
                    style="@style/Text.Value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center" />

                <Button
                    android:id="@+id/limit_more"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_app_button"
                    android:contentDescription="@string/limit_more"
                    android:stateListAnimator="@null"
                    android:text="@string/plus"
                    android:textColor="@color/ink"
                    android:textSize="22sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/send_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="48dp"
                android:text="@string/home_title"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <Button
                android:id="@+id/demo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_app_button"
                android:stateListAnimator="@null"
                android:text="@string/demo"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="16sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:background="@color/line" />

        <!-- what it can see -->
        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/sees_title" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/sees_body" />
    </LinearLayout>
</ScrollView>
