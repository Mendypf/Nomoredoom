<?xml version="1.0" encoding="utf-8"?>
<!--
    The popup that covers the video: a card on a full-screen backdrop.

    The card is a picture with one line under it. The minutes are stamped on the
    picture's corner and the only control is the X on its top right. Leaving is
    the phone's own Home gesture, so there are no buttons.

    card_gif stays hidden unless the card's GIF is on the phone; then the stamp
    carries the minutes and card_minutes is hidden. Stage.kt sets the sizes.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_backdrop"
    android:clickable="true"
    android:fillViewport="true"
    android:importantForAccessibility="no"
    android:overScrollMode="never"
    android:scrollbars="none">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="16dp">

        <!-- The outer frame is stretched to the screen; this one stays the size of the card, so the
             stamp and the X can sit on the card's corners. The card is a picture, laid out the same in
             every language: in a right-to-left one the X would otherwise move under the stamp. -->
        <FrameLayout
            android:id="@+id/card_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clipChildren="false"
            android:layoutDirection="ltr"
            tools:ignore="UselessParent">

            <LinearLayout
                android:id="@+id/card_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <!-- The dark behind it only shows beside a GIF too narrow to fill the card. -->
                <ImageView
                    android:id="@+id/card_gif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/backdrop_edge"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/card_minutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingHorizontal="56dp"
                    android:paddingTop="40dp"
                    android:textColor="@color/card_text"
                    android:textSize="44sp" />

                <TextView
                    android:id="@+id/card_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:breakStrategy="balanced"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingHorizontal="22dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="20dp"
                    android:text="@string/card_caption"
                    android:textColor="@color/card_text"
                    android:textSize="21sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/card_stamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stamp"
                android:fontFamily="sans-serif-black"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:letterSpacing="0.03"
                android:textColor="@color/stamp_text"
                android:visibility="gone" />

            <io.github.mendypf.nomoredoom.CloseButton
                android:id="@+id/card_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|end"
                android:layout_margin="4dp" />
        </FrameLayout>
    </FrameLayout>
</ScrollView>
